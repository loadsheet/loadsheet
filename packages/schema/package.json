{
  "name": "@loadsheet/schema",
  "version": "0.0.1",
  "description": "Types and JSON Schema for loadsheet's Scan, Report and Config.",
  "homepage": "https://loadsheet.dev",
  "license": "MIT",
  "author": "onmax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loadsheet/loadsheet.git",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./report.v1.json": "./schema/report.v1.json",
    "./scan.v1.json": "./schema/scan.v1.json",
    "./config.v1.json": "./schema/config.v1.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "generate": "node scripts/generate.ts",
    "prepack": "pnpm --filter @loadsheet/schema... build"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@valibot/to-json-schema": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
