{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/scripts",
    "packages/*/tsdown.config.ts",
    "packages/*/vite.config.ts",
    "scripts",
    "tsdown.shared.ts",
    "vite.config.ts"
  ],
  // The report UI is Vue and DOM code with its own tsconfig.
  "exclude": ["packages/ui"]
}
