// loadsheet.dev: the built index.html served as static assets. Workers Builds deploys it on push.
{
  "name": "loadsheet",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "loadsheet.dev", "custom_domain": true }],
  // loadsheet.dev is the only public address: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
}
